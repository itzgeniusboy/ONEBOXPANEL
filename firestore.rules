rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+
);
    }

    // Helper to validate LicenseKey format and schema
    function isValidLicenseKey(data) {
      return data.key is string && data.key.size() > 0 && data.key.size() <= 100 &&
             data.label is string && data.label.size() <= 200 &&
             data.status is string && (data.status == 'active' || data.status == 'blocked' || data.status == 'expired') &&
             data.expiryType is string && (data.expiryType == 'lifetime' || data.expiryType == 'duration') &&
             data.deviceLimit is int && data.deviceLimit >= 0 &&
             data.deviceCount is int && data.deviceCount >= 0 &&
             data.sdkType is string && data.sdkType.size() <= 100 &&
             (data.createdAt is string || data.createdAt is timestamp);
    }

    // Helper to validate Log format and schema
    function isValidLog(data) {
      return data.key is string && data.key.size() <= 100 &&
             data.hwid is string && data.hwid.size() <= 200 &&
             data.packageName is string && data.packageName.size() <= 200 &&
             data.status is string && data.status.size() <= 50 &&
             (data.timestamp is string || data.timestamp is timestamp);
    }

    match /keys/{keyId} {
      allow get, list, create, update, delete: if true;
    }

    match /logs/{logId} {
      allow read, create: if true;
    }

    match /apps/{appId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /resellers/{resellerId} {
      allow read, write: if true;
    }
  }
}
